# Compose-level settings for a server deployment (copy to .env next to docker-compose.yml).
POSTGRES_PASSWORD=change-me
AURORA_USER=aurora
# docker compose run --rm proxy caddy hash-password   -> paste the $2a$... hash here
AURORA_PASSWORD_HASH=
# ":80" = plain HTTP on your LAN. A hostname with DNS pointing at this box = automatic HTTPS.
AURORA_DOMAIN=:80
# 08 = 4am Eastern
SYNC_HOUR_UTC=08
# leave empty: the dashboard calls the API on the same origin through the proxy
PUBLIC_API_URL=
