# Compose-level settings for a server deployment (copy to .env next to docker-compose.yml).
POSTGRES_PASSWORD=change-me
AURORA_USER=aurora
# docker compose run --rm proxy caddy hash-password   -> paste the $2a$... hash here
AURORA_PASSWORD_HASH=
# Where the proxy is reachable. 127.0.0.1 = this box only (SSH tunnel:
#   ssh -L 8080:127.0.0.1:8080 user@vps   then open http://localhost:8080).
# Set AURORA_BIND to the Tailscale IP (tailscale ip -4) to reach it over the tailnet.
AURORA_BIND=127.0.0.1
AURORA_HTTP_PORT=8080
AURORA_HTTPS_PORT=8443
# ":80" = plain HTTP inside the proxy (fine behind a tunnel or tailnet).
# A public hostname with DNS pointing at this box = automatic HTTPS; needs AURORA_BIND=0.0.0.0 and 80/443 open.
AURORA_DOMAIN=:80
# 08 = 4am Eastern
SYNC_HOUR_UTC=08
# leave empty: the dashboard calls the API on the same origin through the proxy
PUBLIC_API_URL=
