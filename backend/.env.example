# PostgreSQL (production target). Matches docker-compose.yml.
DATABASE_URL=postgresql+psycopg://aurora:aurora@localhost:5432/aurora

# Zero-setup local dev / tests fall back to SQLite if DATABASE_URL is unset:
# DATABASE_URL=sqlite:///./aurora.db

CORS_ORIGINS=http://localhost:3000
# What the dashboard and weekly report open on: blank = everything, state:FL = one state, or a store code.
DEFAULT_SCOPE=state:FL

# Headset MCP connector (optional). Find the endpoint URL and token in your
# Headset / claude.ai connector settings. Leave blank to replay recorded pulls.
HEADSET_MCP_URL=                 # e.g. https://mcp.headset.io
HEADSET_MCP_TOKEN=               # optional static token; blank = sign in once with `python -m app.cli headset-login` (OAuth, refreshed automatically)
HEADSET_OAUTH_CLIENT_ID=         # OAuth client issued by Headset when self-registration is off (redirect URI http://localhost:8765/callback)
HEADSET_OAUTH_CLIENT_SECRET=     # only if they issue a confidential client
HEADSET_DATA_DIR=./data/headset

# Free external-event stack. A provider runs only when its key is set.
TICKETMASTER_API_KEY=          # developer.ticketmaster.com — Discovery API, 5,000 calls/day
SEATGEEK_CLIENT_ID=            # platform.seatgeek.com
SEATGEEK_CLIENT_SECRET=
ROAD511_API_KEY=               # optional: portal.road511.com (trial, then paid); lifecycle + archived history; wins over FL511 when set
ROAD511_HISTORY=true           # also pull archived events in the sync range
FL511_API_KEY=                 # optional: keyed FL511 feed, issued by FDOT on request; traffic works without it
# FL511_ARCGIS_URL=            # FDOT's public incident layer (default set); blank disables traffic
EVENTS_RADIUS_KM=15
TRAFFIC_RADIUS_KM=5
HOLIDAY_COUNTRY=US
HOLIDAY_SUBDIVISION=FL
# Store devices POST /api/heartbeat?store=CODE&kind=power|network&token=... every minute.
HEARTBEAT_TOKEN=
HEARTBEAT_GAP_MINUTES=5
# Nominatim requires a User-Agent that identifies you.
GEOCODER_USER_AGENT=aurora-ai/0.2 (you@example.com)

# Spreadsheets, read live with no OAuth. Google Sheets must be shared as "anyone
# with the link can view"; the tab is its name or the gid from the tab's URL.
# The promotions workbook is a OneDrive / SharePoint "anyone with the link" share
# URL (or a Google Sheet link, https URL, or local path).
MARKET_SHEET_ID=                 # OMMU market dashboard sheet id (from its URL)
MARKET_SHEET_TAB=                # optional: tab name or gid; blank = found by its columns
MARKET_SELF_OPERATOR=            # e.g. "Demo Operator Florida LLC" (optional when the sheet flags our rows)
DEALS_SHEET_ID=                  # competitor deals workbook sheet id
DEALS_SHEET_TAB=                 # optional: tab name or gid; blank = found by its columns
PROMOTIONS_URL=                  # OneDrive share link to the promotions workbook
PROMOTIONS_SHEET=                # optional: worksheet name; blank = found by a Promo/Name column
PROMOTIONS_COLUMN_MAP=           # JSON, only if headers are unusual: {"name":"Deal Title","start":"Live From"}
PROMOTIONS_IMPORT_PERFORMANCE=false   # true = also load the workbook's own statewide day totals (net/gross/discount/ROI); sales data, so off until approved
MARKET_CENTROID_LAT=28.1         # where statewide events are placed
MARKET_CENTROID_LON=-81.6

# Weekly owner report by email (off until SMTP_HOST and REPORT_TO are set).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
REPORT_TO=                       # comma-separated
REPORT_WEEKDAY=1                 # ISO weekday: 1 = Monday
REPORT_STORE=                    # blank = all stores

# The analyst ("Ask Aurora"): Claude over Aurora's read-only tools. Off until the key is set.
ANTHROPIC_API_KEY=
ANALYST_MODEL=claude-opus-5
ANALYST_EFFORT=high              # low | medium | high | xhigh | max
ANALYST_MAX_ITERATIONS=24
